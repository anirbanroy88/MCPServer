{
  "inputs": [
    {
      "id": "openfigi-key",
      "type": "promptString",
      "description": "OpenFIGI key (leave blank for free access)",
      "password": true
    }
  ],
  "servers": {
    "openfigi": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-jar",
        "C:/absolute/path/MCPServer/openFigi/build/libs/openfigi-mcp.jar",
        "--spring.profiles.active=stdio"
      ],
      "env": {
        "OPENFIGI_API_KEY": "${input:openfigi-key}"
      }
    }
  }
}
